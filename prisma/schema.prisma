// ─────────────────────────────────────────────────────────────────────────────
// MarchéGo — schéma de données
//
// Conventions :
//  • Tous les montants sont stockés en CENTIMES d'euro (Int) pour éviter les
//    erreurs d'arrondi des flottants. Les taux sont en points de base (bps),
//    1500 bps = 15 %.
//  • Les positions sont stockées à la fois en `latitude`/`longitude` (Float,
//    lisibles par Prisma) et dans une colonne PostGIS `geography(Point,4326)`
//    maintenue par trigger (voir migration `postgis_setup`). Les requêtes de
//    proximité passent par `$queryRaw` (cf. `lib/geo/queries.ts`).
//  • Les données sensibles (IBAN, numéros de document) sont chiffrées en
//    AES-256-GCM avant insertion (cf. `lib/security/crypto.ts`).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, pg_trgm, uuidOssp(map: "uuid-ossp")]
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════

enum UserRole {
  CLIENT
  LIVREUR
  VENDEUR
  ADMIN
}

enum AccountStatus {
  ACTIF
  EN_ATTENTE
  SUSPENDU
  DESACTIVE
}

enum Language {
  FR
  NL
  DE
  EN
}

enum VerificationStatus {
  NON_SOUMIS
  EN_ATTENTE
  APPROUVE
  REJETE
  COMPLEMENT_REQUIS
}

enum VehicleType {
  VELO
  VELO_CARGO
  SCOOTER
  VOITURE
  CAMIONNETTE
  A_PIED
}

enum MarketStatus {
  OUVERT
  FERME
  EN_PAUSE
}

enum ProductUnit {
  PIECE
  KG
  GRAMME
  LITRE
  BOTTE
  BARQUETTE
  PORTION
  PAQUET
  DOUZAINE
